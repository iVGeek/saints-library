---
interface Props {
  /** Saint's display name, used to derive initials. */
  name: string;
  /** A single symbol word for the caption, e.g. "Rose". */
  symbol?: string;
  className?: string;
}

const { name, symbol, className = '' } = Astro.props;

const words = name.replace(/^St(\.|eint)\s+/i, '').split(/\s+/);
const initials = words
  .filter((w) => /^[A-Za-zÀ-ÿ]/.test(w))
  .slice(0, 2)
  .map((w) => w[0]!.toUpperCase())
  .join('');
---

<div class:list={['relative overflow-hidden', className]}>
  <svg
    viewBox="0 0 300 400"
    role="img"
    aria-label={`${name}${symbol ? ` — ${symbol}` : ''} (traditional portrait unavailable; shown as a devotional monogram)`}
    class="h-full w-full"
    preserveAspectRatio="xMidYMid slice"
  >
    <defs>
      <radialGradient id={`mg-${initials}`} cx="50%" cy="18%" r="85%">
        <stop offset="0%" stop-color="#2f4380" />
        <stop offset="55%" stop-color="#1a2749" />
        <stop offset="100%" stop-color="#0a1022" />
      </radialGradient>
      <linearGradient id={`mg-border-${initials}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e5d3a7" />
        <stop offset="50%" stop-color="#a87f2e" />
        <stop offset="100%" stop-color="#e5d3a7" />
      </linearGradient>
      <pattern id={`mg-gold-${initials}`} width="18" height="18" patternUnits="userSpaceOnUse">
        <rect width="18" height="18" fill="none" />
        <circle cx="9" cy="9" r="0.9" fill="#d6b97c" opacity="0.35" />
      </pattern>
    </defs>

    <!-- Arch base -->
    <rect width="300" height="400" fill={`url(#mg-${initials})`} />
    <path
      d="M24 398 V150 Q24 40 150 40 Q276 40 276 150 V398 Z"
      fill={`url(#mg-gold-${initials})`}
      opacity="0.5"
      stroke={`url(#mg-border-${initials})`}
      stroke-width="3"
    />
    <path
      d="M34 396 V150 Q34 52 150 52 Q266 52 266 150 V396 Z"
      fill="none"
      stroke="#c6a155"
      stroke-width="1.2"
      opacity="0.65"
    />
    <path d="M44 394 V150 Q44 64 150 64 Q256 64 256 150 V394 Z" fill="rgba(10,16,34,0.35)" />

    <!-- Rosette -->
    <g transform="translate(150 120)">
      <circle r="40" fill="none" stroke="#c6a155" stroke-width="1.4" opacity="0.75" />
      <circle r="30" fill="none" stroke="#d6b97c" stroke-width="0.8" opacity="0.6" />
      <path d="M0 -40 Q14 0 0 40 Q-14 0 0 -40 M-40 0 Q0 14 40 0 Q0 -14 -40 0" fill="none" stroke="#e5d3a7" stroke-width="1" opacity="0.8" />
      <circle r="3" fill="#e5d3a7" />
    </g>

    <!-- Halos -->
    <circle cx="150" cy="120" r="26" fill="none" stroke="#fbdba7" stroke-width="2.2" opacity="0.9" />

    <!-- Initials -->
    <text
      x="150"
      y="270"
      text-anchor="middle"
      font-family="Georgia, 'Times New Roman', serif"
      font-size="120"
      font-weight="600"
      fill="#e5d3a7"
      opacity="0.92"
    >
      {initials || '†'}
    </text>

    <!-- Symbol caption -->
    <text
      x="150"
      y="332"
      text-anchor="middle"
      font-family="Georgia, 'Times New Roman', serif"
      font-size="30"
      font-style="italic"
      fill="#d6b97c"
      opacity="0.9"
    >
      {symbol ?? '†'}
    </text>

    <!-- Flame accents -->
    <path d="M78 366 Q84 356 90 366 Q84 362 78 366 Z" fill="#f2c07a" opacity="0.8" />
    <path d="M210 366 Q216 356 222 366 Q216 362 210 366 Z" fill="#f2c07a" opacity="0.8" />
  </svg>
</div>
