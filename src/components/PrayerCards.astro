---
interface Props {
  prayers: {
    name: string;
    kind?: string;
    text: string;
    source?: string;
  }[];
  dark?: boolean;
}

const { prayers, dark = false } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2">
  {prayers.map((p, i) => (
    <details
      class:list={[
        'group rounded-md border p-5 open:shadow-candle transition-shadow',
        dark ? 'border-gold-600/40 bg-navy-900/50' : 'border-gold-600/40 bg-ivory/80',
      ]}
      style={{ viewTransitionName: `prayer-${i}` }}
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
        <div>
          <h3 class:list={['font-display text-lg font-semibold', dark ? 'text-gold-300' : 'text-navy-900']}>
            {p.name}
          </h3>
          {p.kind && (
            <p class:list={['font-body text-sm', dark ? 'text-parchment-100/60' : 'text-ink-500']}>{p.kind}</p>
          )}
        </div>
        <span class:list={['font-heading text-2xl transition-transform duration-300 group-open:rotate-45', dark ? 'text-gold-400' : 'text-gold-600']} aria-hidden="true">
          +
        </span>
      </summary>
      <div class:list={['mt-4 whitespace-pre-line font-body text-lg leading-relaxed', dark ? 'text-parchment-100/90' : 'text-ink-800']}>
        {p.text}
      </div>
      {p.source && (
        <p class:list={['mt-4 border-t pt-3 font-body text-sm', dark ? 'border-gold-600/25 text-parchment-100/55' : 'border-gold-600/25 text-ink-500']}>
          {p.source}
        </p>
      )}
    </details>
  ))}
</div>
