---
import type { CollectionEntry } from 'astro:content';
import { imageSrc } from '../utils/images';
import { slug } from '../utils/slugs';
import { formatFeast } from '../data/calendar';
import Monogram from './Monogram.astro';

interface Props {
  saint: CollectionEntry<'saints'>;
  index?: number;
}

const { saint } = Astro.props;
const { data } = saint;
const img = imageSrc(data.image, 600);
---

<a
  href={`/saints/${slug(saint.id)}`}
  class="card-glow group flex flex-col overflow-hidden"
  aria-label={`${data.name} — feast ${formatFeast(data.feastDay)}`}
>
  <div class="arch-frame m-3 aspect-[4/4.6] overflow-hidden">
    {
      img ? (
        <img
          src={img}
          alt={data.imageAlt || `${data.name} — ${data.title ?? 'traditional portrait'}`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      ) : (
        <Monogram name={data.name} symbol={data.symbols[0]} className="h-full w-full" />
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
  </div>

  <div class="flex flex-1 flex-col px-4 pb-4">
    <h3 class="font-display text-lg font-semibold leading-snug text-navy-900 group-hover:text-burgundy-700">
      {data.name}
    </h3>
    {data.title && <p class="mt-0.5 font-heading text-base italic text-ink-600">{data.title}</p>}

    <dl class="mt-3 space-y-1 font-body text-[15px] text-ink-700">
      <div class="flex items-center gap-2">
        <dt class="sr-only">Feast day</dt>
        <dd class="flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-gold-600" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M8 3v4M16 3v4M3 10h18" />
          </svg>
          {formatFeast(data.feastDay)}
        </dd>
      </div>
      {data.patronage.length > 0 && (
        <div class="flex items-start gap-1.5">
          <dt class="sr-only">Patronage</dt>
          <dd class="line-clamp-2">
            <span class="text-gold-700">Patron of </span>
            {data.patronage.slice(0, 3).map((p) => p.replace(/-/g, ' ')).join(', ')}
            {data.patronage.length > 3 ? '…' : ''}
          </dd>
        </div>
      )}
    </dl>

    <div class="mt-auto flex items-center justify-between pt-3">
      <span class="label !text-[10px] text-gold-600">{data.region || '—'}</span>
      <span class="font-heading text-gold-700 transition-transform duration-300 group-hover:translate-x-1">Read →</span>
    </div>
  </div>
</a>
