---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { slug } from '../../utils/slugs';
import { imageSrc } from '../../utils/images';

const articles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const rest = articles.filter((a) => a !== featured);
---

<BaseLayout
  title="Articles"
  description="Deeper dives into the art, history, traditions, and feast-day customs of the Catholic saints."
  canonicalPath="/articles"
  bodyClass="parchment-bg"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Articles' }]} />
    <SectionHeading
      label="Reading room"
      title="Articles & Reflections"
      sub="Deeper dives into the art, history, traditions, and feast-day customs of the saints."
    />

    {featured && (
      <a href={`/articles/${slug(featured.id)}`} class="card-glow group mt-10 grid gap-8 p-6 sm:grid-cols-[1fr_2fr] sm:p-8">
        <div class="overflow-hidden rounded-md border border-gold-600/40">
          <img
            src={imageSrc('Cimabue_Saint_Francis_Fragment.jpg', 800) ?? ''}
            alt="Detail from a Cimabue fresco of Saint Francis of Assisi"
            loading="lazy"
            class="h-56 w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-full"
          />
        </div>
        <div class="flex flex-col justify-center">
          <p class="label">Featured article</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-navy-900 group-hover:text-burgundy-700 sm:text-3xl">
            {featured.data.title}
          </h2>
          <p class="mt-3 font-body text-lg text-ink-700">{featured.data.description}</p>
          <div class="mt-5 flex items-center gap-4 font-body text-sm text-ink-500">
            <span>{featured.data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={featured.data.pubDate.toISOString()}>
              {featured.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{featured.data.category}</span>
          </div>
        </div>
      </a>
    )}

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {rest.map((a) => (
        <a href={`/articles/${slug(a.id)}`} class="card-glow group flex flex-col p-6">
          <p class="label !text-[10px]">{a.data.category}</p>
          <h2 class="mt-3 font-display text-xl font-semibold leading-snug text-navy-900 group-hover:text-burgundy-700">
            {a.data.title}
          </h2>
          <p class="mt-3 font-body text-lg text-ink-700">{a.data.description}</p>
          <div class="mt-auto flex items-center justify-between pt-5">
            <time datetime={a.data.pubDate.toISOString()} class="font-body text-sm text-ink-500">
              {a.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span class="font-heading text-gold-700 transition-transform duration-300 group-hover:translate-x-1">Read →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
