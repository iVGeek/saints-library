---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { MONTHS } from '../data/calendar';
import { slug } from '../utils/slugs';

const saints = await getCollection('saints');

const RANK_ORDER: Record<string, number> = {
  Solemnity: 0,
  Feast: 1,
  Memorial: 2,
  'Optional Memorial': 3,
  Commemoration: 4,
};

interface DaySaint {
  id: string;
  name: string;
  rank?: string;
  status: string;
  martyr: boolean;
  summary?: string;
  patronage: string[];
}

const byDay = new Map<string, DaySaint[]>();
for (const s of saints) {
  const key = `${s.data.feastDay.month}-${s.data.feastDay.day}`;
  const list = byDay.get(key) ?? [];
  list.push({
    id: s.id,
    name: s.data.name,
    rank: s.data.liturgicalRank,
    status: s.data.canonizationStatus,
    martyr: s.data.martyr,
    summary: s.data.summary,
    patronage: s.data.patronage,
  });
  byDay.set(key, list);
}

for (const list of byDay.values()) {
  list.sort((a, b) => (RANK_ORDER[a.rank ?? 'Commemoration'] ?? 5) - (RANK_ORDER[b.rank ?? 'Commemoration'] ?? 5));
}

const PREVIEW_COUNT = 6;

const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const daysInMonth = (y: number, m: number) => new Date(y, m, 0).getDate();
const now = new Date();
const year = now.getFullYear();
const today = { m: now.getMonth() + 1, d: now.getDate() };

interface Cell {
  day: number;
  saints: DaySaint[];
}
interface Month {
  month: number;
  name: string;
  cells: (Cell | null)[];
}

const months: Month[] = [];
for (let m = 1; m <= 12; m++) {
  const firstDow = new Date(year, m - 1, 1).getDay();
  const total = daysInMonth(year, m);
  const cells: (Cell | null)[] = Array.from({ length: firstDow }, () => null);
  for (let d = 1; d <= total; d++) {
    cells.push({ day: d, saints: byDay.get(`${m}-${d}`) ?? [] });
  }
  months.push({ month: m, name: MONTHS[m - 1], cells });
}

const rankTone: Record<string, string> = {
  Solemnity: 'bg-burgundy-700 text-ivory',
  Feast: 'bg-gold-600 text-ivory',
  Memorial: 'bg-forest-700 text-ivory',
  'Optional Memorial': 'bg-forest-600 text-ivory',
  Commemoration: 'bg-navy-600 text-ivory',
};

const rankBorder: Record<string, string> = {
  Solemnity: 'border-l-burgundy-700',
  Feast: 'border-l-gold-600',
  Memorial: 'border-l-forest-700',
  'Optional Memorial': 'border-l-forest-600',
  Commemoration: 'border-l-navy-600',
};

const statusDot: Record<string, string> = {
  Saint: 'bg-gold-500',
  Blessed: 'bg-forest-600',
  Venerable: 'bg-navy-500',
};
---

<BaseLayout
  title="Liturgical Calendar"
  description="The feast days and memorials of the saints, gathered into an interactive liturgical calendar for the Church year."
  canonicalPath="/calendar"
  bodyClass="parchment-bg"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Liturgical Calendar' }]} />
    <SectionHeading
      label="The Church's year"
      title="Liturgical Calendar"
      sub="The sanctoral cycle keeps a saint's feast at nearly every turn of the year. Tap a day to see its saints."
    />

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <p class="label">Rank</p>
      {Object.entries(rankTone).map(([rank, tone]) => (
        <span class="flex items-center gap-2 font-body text-sm text-ink-600">
          <span class={`h-3 w-3 rounded-full ${tone}`} />
          {rank}
        </span>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="label">Show:</span>
      <button data-cal-filter="all" class="cal-btn active" type="button">All</button>
      <button data-cal-filter="Saint" class="cal-btn" type="button">Saints</button>
      <button data-cal-filter="Blessed" class="cal-btn" type="button">Blessed</button>
      <button data-cal-filter="Venerable" class="cal-btn" type="button">Venerable</button>
      <button data-cal-filter="martyr" class="cal-btn" type="button">Martyrs</button>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      {months.map((month) => (
        <section class="rounded-lg border border-gold-600/30 bg-ivory/80 p-4">
          <h2 class="mb-4 text-center font-display text-xl font-semibold text-navy-900">{month.name} {year}</h2>
          <div class="grid grid-cols-7 gap-1 text-center">
            {WEEKDAYS.map((w) => (
              <span class="label !text-[10px] py-1">{w}</span>
            ))}
            {month.cells.map((cell) =>
              cell ? (
                <div
                  class:list={[
                    'cal-cell relative rounded border p-1 text-left transition-colors overflow-hidden cursor-pointer hover:ring-1 hover:ring-gold-400',
                    cell.day === today.d && month.month === today.m
                      ? 'border-gold-600 bg-gold-600/15 ring-1 ring-gold-500'
                      : 'border-gold-600/20 bg-parchment-100/60 hover:border-gold-500',
                  ]}
                  data-month={month.month}
                  data-day={cell.day}
                  data-count={cell.saints.length}
                  title={cell.saints.length ? `${cell.saints.length} saint${cell.saints.length > 1 ? 's' : ''} — click to view` : undefined}
                >
                  <span class:list={['absolute right-1 top-1 font-display text-sm font-semibold z-10', cell.day === today.d && month.month === today.m ? 'text-burgundy-700' : 'text-ink-500']}>
                    {cell.day}
                  </span>
                  <div class="mt-5 space-y-0.5 pr-2">
                    {cell.saints.slice(0, PREVIEW_COUNT).map((s) => (
                      <span
                        class:list={[
                          'cal-link block truncate rounded px-1 py-0.5 font-body text-[11px] leading-tight',
                          s.rank ? rankTone[s.rank] ?? 'bg-navy-600/80 text-ivory' : 'bg-navy-600/80 text-ivory',
                        ]}
                        data-status={s.status}
                        data-martyr={String(s.martyr)}
                      >
                        {s.name}
                      </span>
                    ))}
                    {cell.saints.length > PREVIEW_COUNT && (
                      <span class="block text-center font-body text-[10px] text-gold-700">
                        +{cell.saints.length - PREVIEW_COUNT} more
                      </span>
                    )}
                  </div>
                  <div class="cal-hidden-links" style="display:none">
                    {cell.saints.map((s) => (
                      <span
                        class="cal-link-data"
                        data-id={s.id}
                        data-name={s.name}
                        data-rank={s.rank ?? ''}
                        data-status={s.status}
                        data-martyr={String(s.martyr)}
                        data-summary={s.summary ?? ''}
                        data-patronage={s.patronage.join(', ')}
                      />
                    ))}
                  </div>
                </div>
              ) : (
                <span class="min-h-[3.4rem]" aria-hidden="true" />
              )
            )}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-10 text-center">
      <p class="font-body text-ink-500">
        <span class="font-semibold text-navy-900">{saints.length.toLocaleString()}</span> saints across the liturgical year.
        <a href="/saints" class="text-burgundy-700 underline transition-colors hover:text-burgundy-800">Browse the full directory →</a>
      </p>
    </div>
  </div>

  <!-- Day Detail Panel -->
  <div id="day-panel" class="fixed inset-y-0 right-0 z-50 hidden w-full max-w-lg transform transition-transform duration-300 translate-x-full" role="dialog" aria-modal="true" aria-label="Saints for this day">
    <div class="day-panel-backdrop absolute inset-0 bg-navy-950/60 backdrop-blur-sm" data-close-panel></div>
    <div class="relative ml-auto h-full w-full max-w-lg overflow-y-auto border-l border-gold-600/40 bg-ivory shadow-deep">
      <div class="sticky top-0 z-10 border-b border-gold-600/30 bg-ivory/95 backdrop-blur-sm px-5 py-4">
        <div class="flex items-center justify-between">
          <div>
            <p id="panel-month" class="label text-gold-700"></p>
            <h3 id="panel-title" class="font-display text-2xl font-semibold text-navy-900"></h3>
          </div>
          <button id="panel-close" type="button" class="rounded-lg border border-gold-600/30 p-2 text-ink-500 transition-colors hover:bg-gold-600/10 hover:text-navy-900" data-close-panel>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <p id="panel-count" class="mt-1 font-body text-sm text-ink-500"></p>
      </div>
      <div id="panel-saints" class="divide-y divide-gold-600/20 px-5 py-2"></div>
      <div id="panel-empty" class="hidden px-5 py-10 text-center">
        <p class="font-heading text-xl italic text-ink-600">No saints on this day.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .cal-btn {
    border-radius: 9999px;
    border: 1px solid rgba(180, 140, 60, 0.3);
    background: #fdf8f0;
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: #4a3f35;
    transition: all 0.15s;
    cursor: pointer;
  }
  .cal-btn:hover {
    border-color: #b48c3c;
    color: #1a1520;
  }
  .cal-btn.active {
    border-color: #b48c3c;
    background: #b48c3c;
    color: #fdf8f0;
  }
  .day-panel-open {
    overflow: hidden;
  }
</style>

<script is:inline>
(function () {
  var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var RANK_TONE = {
    Solemnity: 'bg-burgundy-700 text-ivory',
    Feast: 'bg-gold-600 text-ivory',
    Memorial: 'bg-forest-700 text-ivory',
    'Optional Memorial': 'bg-forest-600 text-ivory',
    Commemoration: 'bg-navy-600 text-ivory'
  };
  var STATUS_DOT = { Saint: 'bg-gold-500', Blessed: 'bg-forest-600', Venerable: 'bg-navy-500' };

  var btns = document.querySelectorAll('.cal-btn');
  var cells = document.querySelectorAll('.cal-cell');
  var activeFilter = 'all';
  var panel = document.getElementById('day-panel');
  var panelTitle = document.getElementById('panel-title');
  var panelMonth = document.getElementById('panel-month');
  var panelCount = document.getElementById('panel-count');
  var panelSaints = document.getElementById('panel-saints');
  var panelEmpty = document.getElementById('panel-empty');
  var panelClose = document.getElementById('panel-close');

  function esc(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function openPanel(cell) {
    var month = parseInt(cell.getAttribute('data-month'));
    var day = parseInt(cell.getAttribute('data-day'));
    var dataEls = cell.querySelectorAll('.cal-link-data');
    var saints = [];
    dataEls.forEach(function (el) {
      saints.push({
        id: el.getAttribute('data-id'),
        name: el.getAttribute('data-name'),
        rank: el.getAttribute('data-rank'),
        status: el.getAttribute('data-status'),
        martyr: el.getAttribute('data-martyr') === 'true',
        summary: el.getAttribute('data-summary'),
        patronage: el.getAttribute('data-patronage')
      });
    });

    panelMonth.textContent = MONTHS[month - 1];
    panelTitle.textContent = MONTHS[month - 1] + ' ' + day;
    panelCount.textContent = saints.length + ' saint' + (saints.length !== 1 ? 's' : '') + ' commemorated';

    if (saints.length === 0) {
      panelSaints.innerHTML = '';
      panelEmpty.classList.remove('hidden');
    } else {
      panelEmpty.classList.add('hidden');
      panelSaints.innerHTML = saints.map(function (s) {
        var rankClass = s.rank ? (RANK_TONE[s.rank] || 'bg-navy-600/80 text-ivory') : 'bg-navy-600/80 text-ivory';
        var dotClass = STATUS_DOT[s.status] || 'bg-navy-500';
        var patronageHtml = s.patronage ? '<p class="mt-1 font-body text-xs text-ink-500">Patron of: ' + esc(s.patronage) + '</p>' : '';
        var summaryHtml = s.summary ? '<p class="mt-1 font-body text-xs text-ink-600 leading-relaxed line-clamp-2">' + esc(s.summary) + '</p>' : '';
        var martyrTag = s.martyr ? '<span class="ml-2 inline-flex items-center gap-1 rounded bg-burgundy-700/10 px-1.5 py-0.5 text-[10px] font-semibold text-burgundy-700">Martyr</span>' : '';

        return '<div class="flex items-start gap-3 py-3">' +
          '<span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ' + dotClass + '"></span>' +
          '<div class="min-w-0 flex-1">' +
            '<div class="flex flex-wrap items-center gap-1.5">' +
              '<a href="/saints/' + esc(s.id) + '" class="font-heading text-base font-semibold text-navy-900 hover:text-burgundy-700 hover:underline">' + esc(s.name) + '</a>' +
              (s.rank ? '<span class="rounded px-1.5 py-0.5 text-[10px] font-semibold ' + rankClass + '">' + esc(s.rank) + '</span>' : '') +
              martyrTag +
            '</div>' +
            patronageHtml +
            summaryHtml +
          '</div>' +
        '</div>';
      }).join('');
    }

    panel.classList.remove('hidden');
    panel.classList.remove('translate-x-full');
    document.body.classList.add('day-panel-open');
  }

  function closePanel() {
    panel.classList.add('translate-x-full');
    setTimeout(function () { panel.classList.add('hidden'); }, 300);
    document.body.classList.remove('day-panel-open');
  }

  cells.forEach(function (cell) {
    cell.addEventListener('click', function () {
      openPanel(cell);
    });
  });

  panelClose.addEventListener('click', closePanel);
  document.querySelectorAll('[data-close-panel]').forEach(function (el) {
    el.addEventListener('click', closePanel);
  });

  window.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.classList.contains('hidden')) closePanel();
  });

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      btns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-cal-filter');
      applyFilter();
    });
  });

  function applyFilter() {
    cells.forEach(function (cell) {
      var links = cell.querySelectorAll('.cal-link');
      var visibleCount = 0;

      links.forEach(function (link) {
        var status = link.getAttribute('data-status');
        var martyr = link.getAttribute('data-martyr');
        var show = false;

        if (activeFilter === 'all') {
          show = true;
        } else if (activeFilter === 'martyr') {
          show = martyr === 'true';
        } else {
          show = status === activeFilter;
        }

        link.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      var count = parseInt(cell.getAttribute('data-count') || '0');
      cell.style.opacity = visibleCount === 0 && activeFilter !== 'all' ? '0.4' : '1';
    });
  }
})();
</script>
