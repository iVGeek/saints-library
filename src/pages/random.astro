---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slug } from '../utils/slugs';

const saints = await getCollection('saints');
const slugs = saints.map((s) => slug(s.id));
---
<BaseLayout title="Random Saint" description="Discover a random saint from the library." canonicalPath="/random">
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <p class="font-heading text-xl text-parchment-100/70">Drawing a saint from the library…</p>
  </section>
  <script define:vars={{ slugs }} is:inline>
    const pick = slugs[Math.floor(Math.random() * slugs.length)];
    window.location.replace('/saints/' + pick);
  </script>
</BaseLayout>